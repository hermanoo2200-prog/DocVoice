<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" corta a cópia para a nuvem.
  Este ficheiro corta também a transferência directa telemóvel-a-telemóvel (Android 12+),
  que de outro modo levaria consigo o texto reconhecido.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
